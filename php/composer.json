{
    "name": "apiverve/wordpronunciation",
    "description": "Word Pronunciation is a pronunciation API that retrieves the phonetic pronunciation of any English word in ARPAbet format. Pass a word to receive its phonetic transcription for speech synthesis, dictionaries, or language tools.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "wordpronunciation",
        "word pronunciation api",
        "pronunciation api",
        "english pronunciation api",
        "text to arpabet",
        "arpabet translator"
    ],
    "homepage": "https://apiverve.com/marketplace/wordpronunciation?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/wordpronunciation",
        "source": "https://github.com/apiverve/wordpronunciation-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Wordpronunciation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Wordpronunciation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
